<Window x:Class="Positioni.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="using:Positioni.Core" xmlns:local="using:Positioni" Title="Positioni">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="DestructiveButtonForeground" Color="Black"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="DestructiveButtonForeground" Color="White"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="DestructiveButtonForeground" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <FontFamily x:Key="WordmarkFont">Speltale Demo</FontFamily>
   <Style x:Key="ProfileCountBadgeStyle" TargetType="Border">
    <Setter Property="Height" Value="17"/>
    <Setter Property="MinWidth" Value="22"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
   </Style>
   <Style x:Key="StarterRowStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
   </Style>
   <Style x:Key="CompactKeycapStyle" TargetType="Border">
    <Setter Property="MinWidth" Value="23"/>
    <Setter Property="Height" Value="23"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="1,1,1,2"/>
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
   </Style>
   <Style x:Key="ImportDetailTextStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Style>
   <Style x:Key="ProfileCountTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Style>
   <Style x:Key="WrapDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="ContentTemplate">
     <Setter.Value>
      <DataTemplate>
       <TextBlock Text="{Binding}" TextAlignment="Center" TextWrapping="Wrap"/>
      </DataTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="DestructiveDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource WrapDialogButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    <Setter Property="Foreground" Value="{ThemeResource DestructiveButtonForeground}"/>
    <Setter Property="Template">
     <Setter.Value>
      <ControlTemplate TargetType="Button">
       <Grid>
        <VisualStateManager.VisualStateGroups>
         <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver">
           <VisualState.Setters>
            <Setter Target="StateOverlay.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
           </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
           <VisualState.Setters>
            <Setter Target="StateOverlay.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
           </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
           <VisualState.Setters>
            <Setter Target="ButtonSurface.Background" Value="{ThemeResource ControlFillColorDisabledBrush}"/>
            <Setter Target="ButtonContent.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
           </VisualState.Setters>
          </VisualState>
         </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
        <Border x:Name="StateOverlay" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
        <ContentPresenter x:Name="ButtonContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" AutomationProperties.AccessibilityView="Raw"/>
       </Grid>
      </ControlTemplate>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="ExternalLinkIconStyle" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
    <Setter Property="Glyph" Value="&#xE8A7;"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
   </Style>
   <Style x:Key="ScrollTopShadowStyle" TargetType="Border">
    <Setter Property="Height" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Background">
     <Setter.Value>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
       <GradientStop Color="#40000000" Offset="0"/>
       <GradientStop Color="#00000000" Offset="1"/>
      </LinearGradientBrush>
     </Setter.Value>
    </Setter>
   </Style>
   <Style x:Key="ScrollBottomShadowStyle" TargetType="Border">
    <Setter Property="Height" Value="8"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Background">
     <Setter.Value>
      <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
       <GradientStop Color="#40000000" Offset="0"/>
       <GradientStop Color="#00000000" Offset="1"/>
      </LinearGradientBrush>
     </Setter.Value>
    </Setter>
   </Style>
   </ResourceDictionary>
  </Grid.Resources>
  <Button x:Name="BackgroundFocusTarget" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
           Opacity="0" IsTabStop="False" IsHitTestVisible="False" UseSystemFocusVisuals="False"
           AutomationProperties.AccessibilityView="Raw"/>
  <ContentControl x:Name="MainSurface" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <Grid Padding="28" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Canvas x:Name="HeaderLogo" Width="22" Height="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"><Canvas.RenderTransform><TranslateTransform Y="-4"/></Canvas.RenderTransform><Image Source="ms-appx:///Assets/Positioni.png" Width="22" Height="22"/></Canvas>
       <TextBlock x:Name="MainWordmark" Text="Positioni" Style="{ThemeResource TitleTextBlockStyle}" FontFamily="{StaticResource WordmarkFont}" CharacterSpacing="62" FontWeight="Normal" AutomationProperties.HeadingLevel="Level1"/>
      </StackPanel>
      <TextBlock x:Name="DescriptionLabel" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button x:Name="UpdateAvailableButton" Click="UpdateAvailable_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}"/>
      <Button x:Name="PauseButton" Click="Pause_Click" Height="32" Padding="11,0" VerticalContentAlignment="Center">
       <Grid ColumnSpacing="8" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon x:Name="PauseIcon" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center">
         <FontIcon.RenderTransform><TranslateTransform Y="1.5"/></FontIcon.RenderTransform>
        </FontIcon>
        <TextBlock x:Name="PauseLabel" Grid.Column="1" VerticalAlignment="Center"/>
       </Grid>
      </Button>
      <Button x:Name="OptionsButton" Click="Options_Click"/>
      <Button x:Name="AddButton" Click="Add_Click" Style="{ThemeResource AccentButtonStyle}"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="PresetWorkspace" Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid RowSpacing="10" Padding="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4">
        <TextBlock x:Name="PresetsHeading" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Border Style="{StaticResource ProfileCountBadgeStyle}">
         <Border.RenderTransform><TranslateTransform Y="1"/></Border.RenderTransform>
         <TextBlock x:Name="CountLabel" Style="{StaticResource ProfileCountTextStyle}">
          <TextBlock.RenderTransform><TranslateTransform Y="-1"/></TextBlock.RenderTransform>
         </TextBlock>
        </Border>
       </StackPanel>
       <Grid Grid.Row="1">
        <ListView x:Name="PresetList" SelectionChanged="Selection_Changed" SelectionMode="Single" HorizontalContentAlignment="Stretch">
         <ListView.Resources>
          <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
         </ListView.Resources>
         <ListView.ItemContainerTransitions>
          <TransitionCollection>
           <RepositionThemeTransition IsStaggeringEnabled="False"/>
          </TransitionCollection>
         </ListView.ItemContainerTransitions>
         <ListView.ItemTemplate>
          <DataTemplate x:DataType="core:Preset">
           <Grid Padding="2,7" MinHeight="62" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="3" Height="28" CornerRadius="1.5" Margin="-12,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                    Background="{ThemeResource ListViewItemSelectionIndicatorBrush}" Opacity="0"
                    AutomationProperties.AccessibilityView="Raw"
                    Loaded="ProfileSelectionMarker_Loaded" Unloaded="ProfileSelectionMarker_Unloaded"
                    DataContextChanged="ProfileSelectionMarker_DataContextChanged"/>
            <StackPanel Spacing="3" VerticalAlignment="Top">
             <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
             <ContentPresenter Loaded="ProfileListShortcut_Loaded" DataContextChanged="ProfileListShortcut_DataContextChanged"/>
            </StackPanel>
            <local:ProfileThumbnail Grid.Column="1" VerticalAlignment="Top"
                                    Loaded="ProfileThumbnail_Loaded" Unloaded="ProfileThumbnail_Unloaded"
                                    DataContextChanged="ProfileThumbnail_DataContextChanged"/>
           </Grid>
          </DataTemplate>
         </ListView.ItemTemplate>
        </ListView>
        <Border x:Name="PresetListTopShadow" Style="{StaticResource ScrollTopShadowStyle}"/>
        <Border x:Name="PresetListBottomShadow" Style="{StaticResource ScrollBottomShadowStyle}"/>
       </Grid>
       <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5"><Button x:Name="DuplicateButton" Click="Duplicate_Click"/><Button x:Name="UpButton" Click="Up_Click"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74A;" FontSize="12" Width="16" Height="16"/></Button><Button x:Name="DownButton" Click="Down_Click"><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74B;" FontSize="12" Width="16" Height="16"/></Button><Button x:Name="DeleteButton" Click="Delete_Click"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid>
      <ContentControl x:Name="Editor" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="EditLabel" AutomationProperties.HeadingLevel="Level2" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <CheckBox x:Name="EnabledInput" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"/>
       </Grid>
        </Border>
        <ScrollViewer x:Name="EditorScroll" Grid.Row="1"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
         <StackPanel Background="Transparent" Padding="24,18" Spacing="22" Tapped="EditorBackground_Tapped" DoubleTapped="EditorBackground_DoubleTapped" PointerReleased="EditorBackground_PointerReleased">
       <StackPanel.Resources>
        <Style x:Key="EditorCardStyle" TargetType="Border">
         <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
         <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
         <Setter Property="BorderThickness" Value="1"/>
         <Setter Property="CornerRadius" Value="8"/>
         <Setter Property="Padding" Value="16,14"/>
        </Style>
       </StackPanel.Resources>
       <Border Style="{StaticResource EditorCardStyle}">
        <StackPanel Spacing="12">
         <TextBlock x:Name="ProfileNameTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16"
                    AutomationProperties.HeadingLevel="Level3"/>
         <TextBox x:Name="PresetName" IsSpellCheckEnabled="False" MaxLength="150"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource EditorCardStyle}">
        <StackPanel Spacing="12">
         <TextBlock x:Name="GeometryTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16"
                    AutomationProperties.HeadingLevel="Level3"/>
         <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
          <StackPanel Padding="10,10,10,10">
           <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Background="{ThemeResource ControlFillColorDefaultBrush}">
            <TextBlock x:Name="PreviewLabel" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
           </Border>
          <local:ProfilePreviewCanvas x:Name="PreviewArea" Height="200" Background="Transparent" ManipulationMode="None">
           <Canvas.Clip><RectangleGeometry x:Name="PreviewClip"/></Canvas.Clip>
           <Rectangle x:Name="PreviewMonitor" IsHitTestVisible="False" RadiusX="7" RadiusY="7" StrokeThickness="1.5"
                      Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
           <Border x:Name="PreviewTaskbar" IsHitTestVisible="False" Visibility="Collapsed"
                   Background="#393939" AutomationProperties.AccessibilityView="Raw">
            <StackPanel x:Name="PreviewTaskbarIcons" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
             <StackPanel.Resources>
              <Style TargetType="Border">
               <Setter Property="Background" Value="#7A7A7A"/>
               <Setter Property="CornerRadius" Value="0.8"/>
              </Style>
             </StackPanel.Resources>
             <Border/>
             <Border/>
             <Border/>
             <Border/>
             <Border/>
             <Border/>
             <Border/>
             <Border/>
            </StackPanel>
           </Border>
           <Rectangle x:Name="PreviewWindow" IsHitTestVisible="False" RadiusX="7" RadiusY="7" StrokeThickness="1.5" StrokeDashArray="3,2"
                      Stroke="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
            <Rectangle.RenderTransform><TranslateTransform x:Name="PreviewWindowOffset"/></Rectangle.RenderTransform>
            <Rectangle.Fill><SolidColorBrush x:Name="PreviewWindowFill" Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/></Rectangle.Fill>
           </Rectangle>
           <Canvas x:Name="PreviewSnapGuides" IsHitTestVisible="False" Visibility="Collapsed"
                   AutomationProperties.AccessibilityView="Raw"/>
          </local:ProfilePreviewCanvas>
           <TextBlock x:Name="PreviewInteractionHint" FontSize="12" Margin="0,0,0,2" TextAlignment="Center" TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
         </Border>
         <TextBlock x:Name="PreviewCaption" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <StackPanel Spacing="8" Margin="0,10,0,0">
          <TextBlock x:Name="DimensionsLabel" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level4"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
           <StackPanel Spacing="6">
            <TextBlock x:Name="WidthLabel"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
             <NumberBox x:Name="WidthInput" Width="84" Minimum="100" Maximum="32768" SpinButtonPlacementMode="Hidden"/>
             <ComboBox x:Name="WidthUnit" MinWidth="0" VerticalAlignment="Center" SelectionChanged="DimensionUnit_Changed">
              <ComboBoxItem Content="%"/>
              <ComboBoxItem Content="px"/>
             </ComboBox>
            </StackPanel>
           </StackPanel>
           <StackPanel Spacing="6">
            <TextBlock x:Name="HeightLabel"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
             <NumberBox x:Name="HeightInput" Width="84" Minimum="80" Maximum="32768" SpinButtonPlacementMode="Hidden"/>
             <ComboBox x:Name="HeightUnit" MinWidth="0" VerticalAlignment="Center" SelectionChanged="DimensionUnit_Changed">
              <ComboBoxItem Content="%"/>
              <ComboBoxItem Content="px"/>
             </ComboBox>
            </StackPanel>
           </StackPanel>
          </StackPanel>
          <Button x:Name="CaptureButton" Click="Capture_Click"/>
          <TextBlock x:Name="CaptureHintLabel" FontSize="12" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         </StackPanel>
         <StackPanel Spacing="8" Margin="0,12,0,0">
          <TextBlock x:Name="PositionLabel" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level4"/>
          <StackPanel x:Name="PositionSelector" HorizontalAlignment="Left" Spacing="6">
           <Border CornerRadius="6" Padding="10,6"
                   Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <TextBlock x:Name="SelectedPositionLabel" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
           </Border>
           <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="4">
           <Grid x:Name="AlignmentGrid" RowSpacing="2" ColumnSpacing="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.Resources>
             <Style x:Key="AlignmentPointStyle" TargetType="RadioButton">
              <Setter Property="HorizontalAlignment" Value="Stretch"/>
              <Setter Property="Height" Value="28"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter Property="MinHeight" Value="0"/>
              <Setter Property="UseSystemFocusVisuals" Value="True"/>
              <Setter Property="Template">
               <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                 <Border x:Name="PointSurface" CornerRadius="4" Background="Transparent">
                  <VisualStateManager.VisualStateGroups>
                   <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver">
                     <VisualState.Setters><Setter Target="PointSurface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                     <VisualState.Setters><Setter Target="PointSurface.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                     <VisualState.Setters><Setter Target="PointSurface.Opacity" Value="0.45"/></VisualState.Setters>
                    </VisualState>
                   </VisualStateGroup>
                   <VisualStateGroup x:Name="PointSelectionStates">
                    <VisualState x:Name="IdlePoint"/>
                    <VisualState x:Name="SelectedPoint">
                     <VisualState.Setters>
                      <Setter Target="Point.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                      <Setter Target="Point.Width" Value="9"/>
                      <Setter Target="Point.Height" Value="9"/>
                     </VisualState.Setters>
                    </VisualState>
                   </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>
                  <Ellipse x:Name="Point" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                 </Border>
                </ControlTemplate>
               </Setter.Value>
              </Setter>
             </Style>
            </Grid.Resources>
           </Grid>
           </Border>
          </StackPanel>
          <Border Width="260" HorizontalAlignment="Left" CornerRadius="6" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
           <StackPanel>
            <Button x:Name="MorePositionOptions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8">
             <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="MorePositionOptionsLabel" VerticalAlignment="Center"/>
              <FontIcon x:Name="PositionOptionsChevron" Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="12"
                        Glyph="&#xE70D;" AutomationProperties.AccessibilityView="Raw"/>
             </Grid>
            </Button>
            <Canvas x:Name="PositionOptionsViewport" Height="0" Visibility="Collapsed">
             <Canvas.Clip><RectangleGeometry x:Name="PositionOptionsClip"/></Canvas.Clip>
             <StackPanel x:Name="PositionOptionsContent" Width="258" Padding="12,6,12,10" Spacing="4">
            <CheckBox x:Name="ExactPositionInput" MinWidth="0" Click="ExactPosition_Click"/>
            <CheckBox x:Name="KeepPositionInput" MinWidth="0" Click="KeepPosition_Click"/>
            <StackPanel x:Name="Coordinates" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" Visibility="Collapsed">
             <NumberBox x:Name="XInput" Header="X (px)" Width="104" Minimum="-100000" Maximum="100000"/>
             <NumberBox x:Name="YInput" Header="Y (px)" Width="104" Minimum="-100000" Maximum="100000"/>
            </StackPanel>
           </StackPanel>
            </Canvas>
           </StackPanel>
          </Border>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource EditorCardStyle}">
        <StackPanel Spacing="10">
         <TextBlock x:Name="ShortcutLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16"
                    AutomationProperties.HeadingLevel="Level3"/>
          <Border Height="62" Padding="10,0" CornerRadius="6"
                  Background="{ThemeResource SubtleFillColorSecondaryBrush}">
           <Grid IsHitTestVisible="False">
            <ItemsControl x:Name="ShortcutKeys" Visibility="Collapsed" VerticalAlignment="Center">
             <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
             </ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ShortcutKeycap">
               <Grid AutomationProperties.Name="{x:Bind Label}">
                <Border Margin="1,4,0,0" CornerRadius="10" Background="#22000000"/>
                <Border Margin="2,4,1,1" CornerRadius="9" Background="#44000000"/>
                <Border Margin="2,4,2,2" CornerRadius="8" Background="#55000000"/>
                <Border MinWidth="{x:Bind KeyWidth}" Height="47" Margin="0,0,0,4" Padding="5,4,5,7" CornerRadius="9"
                        BorderBrush="#1A1A1A" BorderThickness="1">
                <Border.Background>
                 <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.85">
                  <GradientStop Offset="0" Color="#676765"/>
                  <GradientStop Offset="0.3" Color="#424240"/>
                  <GradientStop Offset="0.65" Color="#242424"/>
                  <GradientStop Offset="1" Color="#080808"/>
                 </LinearGradientBrush>
                </Border.Background>
                <Border CornerRadius="7" Padding="6,0" BorderBrush="#38FFFFFF" BorderThickness="0,1,0,0">
                 <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                   <GradientStop Offset="0" Color="#474745"/>
                   <GradientStop Offset="1" Color="#252525"/>
                  </LinearGradientBrush>
                 </Border.Background>
                 <Grid>
                  <Path Data="M0,0 L6,0 L6,6 L0,6 Z M8,0 L14,0 L14,6 L8,6 Z M0,8 L6,8 L6,14 L0,14 Z M8,8 L14,8 L14,14 L8,14 Z"
                        Width="14" Height="14" Stretch="Uniform" Fill="#EEEEEE" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="{x:Bind WindowsIcon}"/>
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Visibility="{x:Bind TextFace}">
                   <Path Data="M7,1 L13,7 L10,7 L10,13 L4,13 L4,7 L1,7 Z"
                         Width="12" Height="12" Stretch="Uniform" Stroke="#EEEEEE" StrokeThickness="1.3" StrokeLineJoin="Round"
                         VerticalAlignment="Center" Visibility="{x:Bind ShiftIcon}"/>
                   <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             FontSize="14" Foreground="#EEEEEE" Visibility="{x:Bind GlyphVisibility}"
                             AutomationProperties.AccessibilityView="Raw"/>
                   <Path Data="M1,7 L10,7 M7,4 L10,7 L7,10 M13,3 L13,11" Width="14" Height="10" Stretch="Uniform"
                         Stroke="#EEEEEE" StrokeThickness="1.4" StrokeLineJoin="Round"
                         StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                         Visibility="{x:Bind TabIcon}" AutomationProperties.AccessibilityView="Raw"/>
                   <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" Foreground="#EEEEEE"
                              Visibility="{x:Bind LabelVisibility}" VerticalAlignment="Center"/>
                  </StackPanel>
                 </Grid>
                </Border>
                </Border>
               </Grid>
              </DataTemplate>
             </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid x:Name="ShortcutEmptyState" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
             <Rectangle RadiusX="6" RadiusY="6" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        StrokeThickness="1" StrokeDashArray="3,2"/>
             <TextBlock x:Name="ShortcutEmptyLabel" Margin="12,0" VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
           </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
           <Button x:Name="RecordButton" Click="Record_Click" LostFocus="Record_LostFocus"/>
           <Button x:Name="ClearShortcutButton" Click="ClearShortcut_Click" Visibility="Collapsed"/>
           <Button x:Name="UndoShortcutButton" Click="UndoShortcut_Click" Visibility="Collapsed"/>
          </StackPanel>
          <InfoBar x:Name="RecordConflictAlert" Severity="Warning" IsClosable="False" IsOpen="False"/>
          <TextBlock x:Name="RecordHelpLabel" FontSize="12" TextWrapping="Wrap"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource EditorCardStyle}">
        <StackPanel Spacing="12">
         <TextBlock x:Name="ProfileNotesTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16"
                    AutomationProperties.HeadingLevel="Level3"/>
         <TextBox x:Name="PresetNotes" IsSpellCheckEnabled="False" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
        </StackPanel>
       </Border>
       <Border CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
         <Button x:Name="MorePresetOptionsButton" Click="MorePresetOptions_Click"
                 HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="44" Padding="12,8">
          <Grid ColumnSpacing="8">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock x:Name="MorePresetOptionsLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
           <FontIcon x:Name="MorePresetOptionsChevron" Grid.Column="1" FontFamily="Segoe Fluent Icons" Glyph="&#xE70D;" FontSize="12"
                     AutomationProperties.AccessibilityView="Raw"/>
          </Grid>
         </Button>
        <StackPanel x:Name="MorePresetOptionsContent" Spacing="16" Padding="12,8,12,14" Visibility="Collapsed">
         <StackPanel.Resources>
          <Style x:Key="PresetOptionHint" TargetType="TextBlock">
           <Setter Property="FontSize" Value="12"/>
           <Setter Property="TextWrapping" Value="Wrap"/>
           <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
          </Style>
         </StackPanel.Resources>
         <StackPanel Spacing="2">
          <CheckBox x:Name="PrimaryInput"/>
          <TextBlock x:Name="PrimaryHintLabel" Style="{StaticResource PresetOptionHint}" Margin="28,0,0,0"/>
         </StackPanel>
         <StackPanel Spacing="2">
          <CheckBox x:Name="KeepSizeInput"/>
          <TextBlock x:Name="KeepSizeHintLabel" Style="{StaticResource PresetOptionHint}" Margin="28,0,0,0"/>
         </StackPanel>
         <StackPanel Spacing="2">
          <CheckBox x:Name="OutsideInput"/>
          <TextBlock x:Name="OutsideHintLabel" Style="{StaticResource PresetOptionHint}" Margin="28,0,0,0"/>
         </StackPanel>
        </StackPanel>
        </StackPanel>
       </Border>
         </StackPanel>
        </ScrollViewer>
        <Border x:Name="EditorTopShadow" Grid.Row="1" Style="{StaticResource ScrollTopShadowStyle}"/>
        <Border x:Name="EditorBottomShadow" Grid.Row="1" Style="{StaticResource ScrollBottomShadowStyle}"/>
        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
       <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
         <Button x:Name="DeleteEditorButton" Click="Delete_Click"/>
         <Button x:Name="ResetProfileButton" Click="ResetProfile_Click" IsEnabled="False"/>
         <Button x:Name="SaveButton" Click="Save_Click" IsEnabled="False"/>
        </StackPanel>
        </Border>
       </Grid>
      </ContentControl>
      <StackPanel x:Name="EmptyProfilesPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="20" MaxWidth="420" Spacing="6">
       <TextBlock x:Name="EmptyProfilesTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center"
                  TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
       <TextBlock x:Name="EmptyProfilesHint" TextAlignment="Center" TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Grid ColumnSpacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="EmptyChooseStarterProfilesButton" Click="EmptyChooseStarterProfiles_Click" VerticalAlignment="Stretch">
         <TextBlock x:Name="EmptyChooseStarterProfilesText" TextAlignment="Center" TextWrapping="Wrap"/>
        </Button>
        <Button x:Name="EmptyAddProfileButton" Grid.Column="1" Click="Add_Click" Style="{ThemeResource AccentButtonStyle}"
                VerticalAlignment="Stretch">
         <TextBlock x:Name="EmptyAddProfileText" TextAlignment="Center" TextWrapping="Wrap"/>
        </Button>
       </Grid>
      </StackPanel>
      </Grid>
     </Border>
    </Grid>

   </Grid>
  </ContentControl>
  <Grid x:Name="WelcomeSurface" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
   <Grid MaxWidth="500" Margin="40,32,40,44" RowSpacing="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="8">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="9"
                 AutomationProperties.AccessibilityView="Raw">
      <Canvas x:Name="WelcomeLogo" Width="46" Height="46" VerticalAlignment="Center"><Image Source="ms-appx:///Assets/PositioniWelcome.png" Width="46" Height="46"/></Canvas>
      <TextBlock Text="Positioni" FontFamily="{StaticResource WordmarkFont}" CharacterSpacing="62"
                 FontSize="39" VerticalAlignment="Center">
       <TextBlock.RenderTransform><TranslateTransform Y="5.3"/></TextBlock.RenderTransform>
      </TextBlock>
     </StackPanel>
     <TextBlock x:Name="WelcomeTitle" Style="{ThemeResource TitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
     <StackPanel Spacing="3">
      <TextBlock x:Name="WelcomeDescription" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="WelcomeHint" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </StackPanel>
    <ContentControl x:Name="WelcomePicker" Grid.Row="1" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid>
  </Grid>
  <Grid x:Name="OptionsOverlay" Visibility="Collapsed" Canvas.ZIndex="1" Background="#A6000000">
   <Border Margin="24" MaxWidth="800" MaxHeight="740" Padding="24"
           Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
    <Grid RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="StarterBackButton" Click="StarterBack_Click" Visibility="Collapsed" HorizontalAlignment="Left">
       <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="14" AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock x:Name="StarterBackText"/>
       </StackPanel>
      </Button>
      <TextBlock x:Name="OptionsTitle" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
      <Button x:Name="CloseOptionsButton" Grid.Column="1" Click="CloseOptions_Click" VerticalAlignment="Top">
       <Button.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CloseOptionsAccelerator_Invoked"/>
       </Button.KeyboardAccelerators>
       <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="10" Width="14" Height="14"/>
      </Button>
     </Grid>
     <ScrollViewer x:Name="OptionsScroll" Grid.Row="1" HorizontalContentAlignment="Stretch">
      <Grid Padding="0,0,12,4" Background="Transparent" Tapped="EditorBackground_Tapped" DoubleTapped="EditorBackground_DoubleTapped" PointerReleased="EditorBackground_PointerReleased">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="720"/></Grid.ColumnDefinitions>
       <StackPanel Spacing="12">
        <StackPanel.Resources>
         <Style x:Key="SettingsCardStyle" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
          <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Padding" Value="20,16"/>
         </Style>
         <Style x:Key="TransferCardStyle" TargetType="Border">
          <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
          <Setter Property="CornerRadius" Value="8"/>
          <Setter Property="Padding" Value="14,12"/>
         </Style>
        </StackPanel.Resources>
   
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <TextBlock x:Name="SystemStartupLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <CheckBox x:Name="Startup" Click="Startup_Click"/>
