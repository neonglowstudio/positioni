              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ImportSource" MinWidth="0" HorizontalAlignment="Left"/>
              <Button x:Name="ImportButton" Grid.Column="1" VerticalAlignment="Center" Click="Import_Click"/>
             </Grid>
            </StackPanel>
           </Border>
           <Border x:Name="ExportCard" Grid.Column="1" Style="{StaticResource TransferCardStyle}">
            <StackPanel Spacing="8">
             <TextBlock x:Name="ExportLabel" TextWrapping="Wrap"/>
             <Button x:Name="ExportButton" Click="Export_Click"/>
            </StackPanel>
           </Border>
          </Grid>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <TextBlock x:Name="StarterProfilesTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <TextBlock x:Name="StarterProfilesHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <Button x:Name="ChooseStarterProfilesButton" Click="ChooseStarterProfiles_Click"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <TextBlock x:Name="DeleteProfilesLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <TextBlock x:Name="DeleteProfilesHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <Button x:Name="DeleteAllProfilesButton" Click="DeleteAllProfiles_Click"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <TextBlock x:Name="OtherSettingsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <StackPanel Spacing="2">
           <CheckBox x:Name="DisableSpellCheck" IsChecked="True" Click="DisableSpellCheck_Click"/>
           <TextBlock x:Name="SpellCheckHint" Margin="28,0,0,0" FontSize="12" TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="12">
          <TextBlock x:Name="AboutLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <Border Style="{StaticResource TransferCardStyle}" Padding="18,16">
           <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
             <Canvas x:Name="AboutLogo" Width="22" Height="22" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"><Canvas.RenderTransform><TranslateTransform Y="-4"/></Canvas.RenderTransform><Image Source="ms-appx:///Assets/Positioni.png" Width="22" Height="22"/></Canvas>
             <TextBlock x:Name="AboutWordmark" Text="Positioni" FontSize="26" FontFamily="{StaticResource WordmarkFont}" CharacterSpacing="62" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="VersionLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
