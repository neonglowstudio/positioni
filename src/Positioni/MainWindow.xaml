           <TextBlock x:Name="StartupConflictText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
           <Button x:Name="UseStartupCopyButton" Click="UseStartupCopy_Click"/>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="10">
          <TextBlock x:Name="UpdatesTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <TextBlock x:Name="UpdateDemoLabel" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <CheckBox x:Name="AutoUpdateCheck" Click="AutoUpdateCheck_Click"/>
          <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click"/>
          <TextBlock x:Name="UpdateMessage" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
           <Button x:Name="ApplyUpdateButton" Click="ApplyUpdate_Click" Visibility="Collapsed" Style="{ThemeResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
             <TextBlock x:Name="ApplyUpdateLabel" VerticalAlignment="Center"/>
             <FontIcon x:Name="ApplyUpdateExternalIcon" Style="{StaticResource ExternalLinkIconStyle}" Visibility="Collapsed"/>
            </StackPanel>
           </Button>
           <Button x:Name="UpdateNotesButton" Click="UpdateNotes_Click" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
             <TextBlock x:Name="UpdateNotesLabel" VerticalAlignment="Center"/>
             <FontIcon Style="{StaticResource ExternalLinkIconStyle}"/>
            </StackPanel>
           </Button>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <TextBlock x:Name="LanguageLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <ComboBox x:Name="LanguageInput" MinWidth="0" HorizontalAlignment="Left" SelectionChanged="Language_Changed"/>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <TextBlock x:Name="ThemeTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
          <StackPanel>
           <RadioButton x:Name="SystemThemeRadio" GroupName="AppTheme"/>
           <RadioButton x:Name="LightThemeRadio" GroupName="AppTheme"/>
           <RadioButton x:Name="DarkThemeRadio" GroupName="AppTheme"/>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="8">
          <StackPanel Spacing="4">
           <TextBlock x:Name="CloseBehaviorTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
           <TextBlock x:Name="CloseBehaviorHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <StackPanel>
           <RadioButton x:Name="CloseToTrayRadio" GroupName="CloseBehavior">
            <TextBlock x:Name="CloseToTrayLabel" TextWrapping="Wrap"/>
           </RadioButton>
           <RadioButton x:Name="ExitOnCloseRadio" GroupName="CloseBehavior">
            <TextBlock x:Name="ExitOnCloseLabel" TextWrapping="Wrap"/>
           </RadioButton>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
         <StackPanel Spacing="12">
          <StackPanel Spacing="4">
           <TextBlock x:Name="BackupsLabel" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" AutomationProperties.HeadingLevel="Level3"/>
           <TextBlock x:Name="BackupHintLabel" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <Grid ColumnSpacing="12" SizeChanged="TransferLayout_SizeChanged">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
