              <PathIcon Data="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock x:Name="RepositoryLinkLabel" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <FontIcon Style="{StaticResource ExternalLinkIconStyle}"/>
             </StackPanel>
            </Button>
           </StackPanel>
          </Border>
          <Border Style="{StaticResource TransferCardStyle}" Padding="18,16" Margin="0,4,0,0">
           <StackPanel Spacing="10">
            <Grid Width="48" Height="48" Margin="2,4,0,4" HorizontalAlignment="Left" IsHitTestVisible="False">
             <Grid x:Name="StudioGlowHost"/>
             <Image x:Name="StudioLogo" Source="ms-appx:///Assets/NeonGlow.png" ImageOpened="StudioLogo_ImageOpened" AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
            <StackPanel Spacing="4">
             <TextBlock x:Name="CreatedByLabel" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
             <TextBlock Text="A product studio for building great software." Language="en" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="StudioLink" Tag="https://neonglow.studio/" Click="AboutLink_Click" AutomationProperties.Name="neonglow.studio">
             <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
              <TextBlock Text="neonglow.studio" VerticalAlignment="Center"/>
              <FontIcon Style="{StaticResource ExternalLinkIconStyle}"/>
             </StackPanel>
            </Button>
           </StackPanel>
          </Border>
         </StackPanel>
        </Border>
       </StackPanel>
      </Grid>
     </ScrollViewer>
     <ContentControl x:Name="OptionsStarterPicker" Grid.Row="1" Visibility="Collapsed" IsTabStop="False"
                     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <Border x:Name="OptionsTopShadow" Grid.Row="1" Style="{StaticResource ScrollTopShadowStyle}"/>
     <Border x:Name="OptionsBottomShadow" Grid.Row="1" Style="{StaticResource ScrollBottomShadowStyle}"/>

    </Grid>
   </Border>
  </Grid>
  <Border x:Name="DialogBackdrop" Canvas.ZIndex="3" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Grid x:Name="ToastHost" Canvas.ZIndex="2" Visibility="Collapsed" IsHitTestVisible="False"
        Margin="16,0,16,24" HorizontalAlignment="Center" VerticalAlignment="Bottom"
        MinWidth="224" MaxWidth="440">
   <Grid.RenderTransform>
    <TranslateTransform x:Name="ToastTranslation"/>
   </Grid.RenderTransform>
   <Border CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <ScrollViewer MaxHeight="260" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
     <InfoBar x:Name="ToastStatus" IsOpen="False" IsClosable="True" Closing="Toast_Closing"
              CornerRadius="7" BorderThickness="0"/>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Window>
