<UserControl
    x:Class="Positioni.ProfileThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="92" IsTabStop="False" IsHitTestVisible="False"
    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
    <StackPanel>
     <Canvas x:Name="InactiveBadgeViewport" Height="0" Visibility="Collapsed">
        <Canvas.Clip><RectangleGeometry x:Name="InactiveBadgeClip"/></Canvas.Clip>
        <Border x:Name="InactiveBadge" CornerRadius="4" MaxWidth="92" Padding="5,2" Margin="0,0,0,4"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <TextBlock x:Name="InactiveBadgeText" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
     </Canvas>
     <Canvas x:Name="ThumbnailCanvas" Width="76" Height="48" HorizontalAlignment="Right"
             AutomationProperties.AccessibilityView="Raw">
        <Rectangle x:Name="MonitorOutline" RadiusX="4" RadiusY="4" StrokeThickness="1"
                   Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"/>
        <Rectangle x:Name="WindowOutline" RadiusX="3" RadiusY="3" StrokeThickness="1" StrokeDashArray="3,2"
                   Stroke="{ThemeResource AccentFillColorDefaultBrush}">
            <Rectangle.Fill>
                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.16"/>
            </Rectangle.Fill>
        </Rectangle>
     </Canvas>
    </StackPanel>
</UserControl>
