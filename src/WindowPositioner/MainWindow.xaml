<Window x:Class="WindowPositioner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Window Positioner">
 <Grid x:Name="Root" Padding="28" RowSpacing="20" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="Window Positioner" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="Presets de tamaño y posición para la ventana activa." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Button x:Name="PauseButton" Grid.Column="1" Content="Pausar atajos" Click="Pause_Click" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Agregar preset" Click="Add_Click" Style="{ThemeResource AccentButtonStyle}"/><Button Content="Importar" Click="Import_Click"/><Button Content="Exportar" Click="Export_Click"/></StackPanel>
   <CheckBox x:Name="Startup" Grid.Column="1" Content="Iniciar con Windows" Click="Startup_Click"/>
  </Grid>
  <Grid Grid.Row="2" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <Grid RowSpacing="10" Padding="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="CountLabel" Text="PRESETS" FontWeight="SemiBold" Margin="8,4"/>
     <ListView x:Name="PresetList" Grid.Row="1" SelectionChanged="Selection_Changed" SelectionMode="Single" HorizontalContentAlignment="Stretch">
      <ListView.ItemTemplate><DataTemplate><StackPanel Padding="2,8" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5"><Button Content="Duplicar" Click="Duplicate_Click"/><Button Content="↑" AutomationProperties.Name="Subir preset" Click="Up_Click"/><Button Content="↓" AutomationProperties.Name="Bajar preset" Click="Down_Click"/><Button Content="Borrar" Click="Delete_Click"/></StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
    <ScrollViewer><ContentControl x:Name="Editor" HorizontalContentAlignment="Stretch"><StackPanel Padding="24" Spacing="16">
     <TextBlock Text="Editar preset" Style="{ThemeResource SubtitleTextBlockStyle}"/>
     <TextBox x:Name="PresetName" Header="Nombre" MaxLength="150"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><NumberBox x:Name="WidthInput" Header="Ancho (px)" Minimum="100" Maximum="32768" SpinButtonPlacementMode="Compact"/><NumberBox x:Name="HeightInput" Grid.Column="1" Header="Alto (px)" Minimum="80" Maximum="32768" SpinButtonPlacementMode="Compact"/></Grid>
     <ComboBox x:Name="PlacementInput" Header="Posición" HorizontalAlignment="Stretch" SelectionChanged="Placement_Changed"/>
     <Grid x:Name="Coordinates" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><NumberBox x:Name="XInput" Header="X (px)" Minimum="-100000" Maximum="100000"/><NumberBox x:Name="YInput" Grid.Column="1" Header="Y (px)" Minimum="-100000" Maximum="100000"/></Grid>
     <CheckBox x:Name="PrimaryInput" Content="Usar monitor principal para las posiciones relativas"/>
     <StackPanel Orientation="Horizontal" Spacing="14"><CheckBox x:Name="KeepSizeInput" Content="Conservar tamaño"/><CheckBox x:Name="OutsideInput" Content="Permitir fuera del área útil"/></StackPanel>
     <StackPanel Spacing="8"><TextBlock Text="Atajo de teclado"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="RecordButton" Content="Grabar atajo" Click="Record_Click" KeyDown="Record_KeyDown" LostFocus="Record_LostFocus" MinWidth="210"/><Button Content="Quitar atajo" Click="ClearShortcut_Click"/></StackPanel><TextBlock Text="Durante la grabación, pulsá Ctrl, Shift, Alt o Win junto con una letra, número o F1–F12. Escape cancela." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <CheckBox x:Name="EnabledInput" Content="Preset activo"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Guardar preset" Click="Save_Click" Style="{ThemeResource AccentButtonStyle}"/><Button Content="Capturar ventana…" Click="Capture_Click"/><Button Content="Aplicar en 3 s" Click="Apply_Click"/></StackPanel>
     <TextBlock Text="Capturar o aplicar: tenés unos segundos para elegir otra ventana. Las medidas corresponden al marco visible, en píxeles físicos." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel></ContentControl></ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="3" Spacing="8"><InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" Message="Preparado."/><TextBlock Text="Al cerrar esta ventana, los atajos siguen activos junto al reloj. Usá Salir en el icono para cerrar la aplicación." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
